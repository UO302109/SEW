<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <Placemark>
      <name>Pueblo de Atapuerca</name>
      <description>Punto de partida</description>
      <Point>
        <coordinates>-3.507221,42.376606,954</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Pueblo de Atapuerca</name>
      <description>Pequeña localidad burgalesa famosa por dar nombre a los yacimientos arqueológicos próximos, Patrimonio de la Humanidad. Por su iglesia parroquial de San Martín de Tours pasa el Camino de Santiago Francés.</description>
      <Point>
        <coordinates>-3.507221,42.376606,954</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Yacimientos de Atapuerca</name>
      <description>Conjunto de yacimientos paleontológicos y arqueológicos declarado Patrimonio de la Humanidad por la UNESCO en 2000. Aquí se han encontrado los restos humanos más antiguos de Europa, incluyendo los del Homo antecessor.</description>
      <Point>
        <coordinates>-3.519562,42.348795,993</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Pueblo de Agés</name>
      <description>Localidad medieval del Camino de Santiago, conocida por su iglesia parroquial de Santa Eulalia y por ser punto tradicional de descanso de peregrinos jacobeos.</description>
      <Point>
        <coordinates>-3.479322,42.369672,968</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Monasterio de San Juan de Ortega</name>
      <description>Conjunto monástico medieval fundado en el siglo XII por San Juan de Ortega, discípulo de Santo Domingo de la Calzada. Famoso por el milagro de la luz equinoccial sobre el capitel de la Anunciación. Hito clave del Camino de Santiago.</description>
      <Point>
        <coordinates>-3.436611,42.375683,1007</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Olmos de Atapuerca</name>
      <description>Pequeña localidad situada al norte de la Sierra de Atapuerca, con iglesia parroquial del siglo XVI. Punto final de la ruta turística que recorre los principales hitos arqueológicos y jacobeos de la comarca.</description>
      <Point>
        <coordinates>-3.532384,42.391112,946</coordinates>
      </Point>
    </Placemark>
