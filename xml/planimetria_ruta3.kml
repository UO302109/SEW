<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <Placemark>
      <name>Pueblo de Hortigüela</name>
      <description>Punto de partida</description>
      <Point>
        <coordinates>-3.426503,42.068343,941</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Hortigüela</name>
      <description>Pequeña localidad burgalesa situada en el valle del río Arlanza, punto de partida tradicional para visitar el Monasterio de San Pedro de Arlanza y los parajes naturales del entorno.</description>
      <Point>
        <coordinates>-3.426503,42.068343,941</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Monasterio de San Pedro de Arlanza</name>
      <description>Conjunto monástico medieval considerado la cuna del condado de Castilla, fundado en el siglo IX. Lugar donde residió el conde Fernán González y donde estuvo enterrado. Sus ruinas, en un entorno natural espectacular junto al río Arlanza, están declaradas Bien de Interés Cultural.</description>
      <Point>
        <coordinates>-3.467101,42.048629,934</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Ermita de San Pelayo</name>
      <description>Pequeña ermita rural románica del siglo XI a orillas del río Arlanza, dedicada al niño mártir San Pelayo. Uno de los ejemplos más antiguos de arquitectura románica rural conservada en la zona.</description>
      <Point>
        <coordinates>-3.467949,42.046232,968</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Ermita de San Olav</name>
      <description>Única ermita dedicada a un santo noruego en España. Inaugurada en 2011 por la familia real noruega, conmemora a la princesa Cristina de Noruega, casada con el infante Felipe de Castilla en 1258 y enterrada en la Colegiata de Covarrubias.</description>
      <Point>
        <coordinates>-3.498220,42.059676,928</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Covarrubias</name>
      <description>Villa medieval declarada Conjunto Histórico-Artístico Nacional, cuna del condado de Castilla y residencia de la infanta Cristina de Noruega. Conserva calles porticadas, casas de entramado de madera y la Colegiata de San Cosme y San Damián.</description>
      <Point>
        <coordinates>-3.519185,42.060109,903</coordinates>
      </Point>
    </Placemark>
